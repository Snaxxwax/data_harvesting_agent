# Build-time configuration, read by `docker compose build`. Non-secret: pinned package
# specs only. Tracked on purpose -- HARVEST_TOOL_PACKAGES is a Dockerfile ARG defaulting
# to empty, so a plain `docker compose build` silently produces an image with no maigret
# and jobs then fail with "maigret is not installed in this worker image". The build still
# prints "Built", so its output does not tell you anything went wrong.
#
# Load it before building:
#   set -a; . ./.env.build; set +a
#   docker compose -f compose.yaml -f compose.override.yaml -f compose.egress-proxy.yaml build
# then confirm, do not assume:
#   docker exec harvest-platform-worker-1 maigret --version
HARVEST_TOOL_PACKAGES=maigret==0.6.6
