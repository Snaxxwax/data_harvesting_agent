worker_processes auto;
pid /tmp/nginx.pid;
events { worker_connections 1024; }
http {
    # Never log query strings, credentials, or bootstrap fragments.
    access_log off;
    error_log /dev/stderr warn;
    server_tokens off;
    client_max_body_size 32m;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    map $http_origin $harvest_origin_ok {
        default 0;
        '' 1;
        'https://@@TAILNET_HOST@@' 1;
    }
    map $http_origin $spiderfoot_origin_ok {
        default 0;
        '' 1;
        'https://@@TAILNET_HOST@@:8443' 1;
    }
    server {
        # Only tailscaled and trusted host processes can reach this listener.
        listen 127.0.0.1:18083;
        server_name @@TAILNET_HOST@@;
        if ($harvest_origin_ok = 0) { return 403; }
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control no-store always;
        location / {
            proxy_pass http://@@UPSTREAM_IP@@:8000;
            proxy_set_header Host $host;
            proxy_set_header Authorization 'Bearer @@HARVEST_TOKEN@@';
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_read_timeout 300s;
            proxy_buffering off;
        }
    }
    server {
        listen 127.0.0.1:18084;
        server_name @@TAILNET_HOST@@;
        if ($spiderfoot_origin_ok = 0) { return 403; }
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control no-store always;
        # Activate the existing frontend token store before its deferred app bundle.
        # This public marker is not a credential; the gateway supplies the real key.
        location = /_tailnet/bootstrap.js {
            default_type application/javascript;
            return 200 "localStorage.setItem('sf_access_token','tailnet-proxy');localStorage.setItem('sf_api_key','tailnet-proxy');localStorage.removeItem('sf_refresh_token');";
        }
        location = /login {
            return 302 https://@@TAILNET_HOST@@:8443/;
        }
        # Logging out a network-authenticated browser must not revoke the shared
        # operator's unrelated sessions. Reloading still authenticates via tailnet.
        location = /api/auth/logout {
            default_type application/json;
            return 200 '{"message":"Access is managed by Tailscale"}';
        }
        location / {
            proxy_pass http://@@UPSTREAM_IP@@:3000;
            proxy_set_header Accept-Encoding '';
            sub_filter '</head>' '<script src="/_tailnet/bootstrap.js"></script></head>';
            sub_filter_once on;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Authorization 'Bearer @@SPIDERFOOT_KEY@@';
            proxy_set_header X-API-Key '';
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 300s;
            proxy_buffering off;
        }
    }
}
