[Unit]
Description=Harvest low-volume discovery search canary
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/harvest/app
ExecStart=/bin/sh -c 'rc=0; docker compose exec -T worker harvest search-canary >/dev/null || rc=$?; [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ]'
